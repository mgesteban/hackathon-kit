# .env.example — authoritative shape of secrets this app reads.
#
# Rule: every env var the code references MUST appear here with a placeholder
# value. The real `.env` is gitignored and never committed. Before every
# commit, diff this file against actual usage:
#
#   grep -rE 'os\.environ|process\.env|getenv' --include='*.py' --include='*.ts' --include='*.tsx' --include='*.js'
#
# Common Grace secrets — uncomment + fill the ones this app actually uses:

# --- Supabase ---
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=                 # client-safe
# SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY — never bundle into client

# --- Anthropic ---
# ANTHROPIC_API_KEY=

# --- OpenAI ---
# OPENAI_API_KEY=

# --- Twilio (voice / SMS) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- ElevenLabs ---
# Scoped keys default to ZERO permissions — explicitly enable text_to_speech
# and voices_read at key creation, or every call 401s.
# ELEVENLABS_API_KEY=

# --- Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- App ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000
